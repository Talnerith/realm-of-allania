rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- 1. CORE FUNCTIONS ---
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }

    // Helper to get current character count (default to 0 if missing)
    function getCharCount(userId) {
       return exists(/databases/$(database)/documents/artifacts/realm-of-allania-v2/users/$(userId)/settings/account)
              ? get(/databases/$(database)/documents/artifacts/realm-of-allania-v2/users/$(userId)/settings/account).data.get('characterCount', 0)
              : 0;
    }

    // SAFE ROLE CHECK:
    function getUserRole() {
      // Check if document exists first to avoid crash
      return exists(/databases/$(database)/documents/artifacts/realm-of-allania-v2/users/$(request.auth.uid)/settings/account)
             ? get(/databases/$(database)/documents/artifacts/realm-of-allania-v2/users/$(request.auth.uid)/settings/account).data.role
             : 'user';
    }
    
    function isAdmin() { return isSignedIn() && getUserRole() == 'admin'; }
    function isMod() { return isSignedIn() && (getUserRole() == 'admin' || getUserRole() == 'moderator'); }
    function isBanned() { return isSignedIn() && getUserRole() == 'banned'; }
    // Trusted users can bypass moderation - includes trusted role, mods, and admins
    function isTrusted() { return isSignedIn() && (getUserRole() == 'trusted' || getUserRole() == 'moderator' || getUserRole() == 'admin'); }

    // --- 2. VALIDATION (Anti-Spam & Limits) ---
    function isValidContent(text) { return text is string && text.size() >= 10 && text.size() <= 10000; }
    function isValidPostContent(text) { return text is string && text.size() >= 10 && text.size() <= 5000; }
    function isValidTitle(title) { return title is string && title.size() >= 3 && title.size() <= 140; }
    function isValidGallery(gallery) { return gallery is list && gallery.size() <= 5; }

    // --- 3. APP RULES ---
    match /artifacts/realm-of-allania-v2 {

      // D. PRESENCE (Active Users)
      match /presence/{userId} {
        allow read: if isSignedIn();
        allow write: if isOwner(userId);
      }

      // A. USER PROFILES

      // A. USER PROFILES
      match /users/{userId} {
        match /settings/account {
          allow read: if isOwner(userId) || isMod();

          // Admin Permissions (Strict Role Enforcement)
          allow create: if isAdmin() && request.resource.data.role in ['user', 'trusted', 'moderator', 'admin', 'banned'];
          allow update: if isAdmin() && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) || request.resource.data.role in ['user', 'trusted', 'moderator', 'admin', 'banned']);
          allow delete: if isAdmin();

          // User Permissions (characterCount may only move by 1 per write, so the
          // 10-character cap can't be reset by writing an arbitrary low value)
          allow create: if isOwner(userId) && request.resource.data.role == 'user';
          allow update: if isOwner(userId)
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
                        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['characterCount'])
                            || (request.resource.data.characterCount is int
                                && request.resource.data.characterCount >= 0
                                && request.resource.data.characterCount <= 10
                                && (request.resource.data.characterCount - resource.data.get('characterCount', 0)) in [-1, 1]));
        }

        match /characters/{charId} {
          allow read: if true;
          allow create: if isOwner(userId) && !isBanned() && getCharCount(userId) < 10;
          allow update, delete: if isOwner(userId) || isAdmin();
        }

        match /readReceipts/{threadId} {
          allow read, write: if isOwner(userId);
        }

        match /notifications/{notificationId} {
          allow read: if isOwner(userId);
          allow update: if isOwner(userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
          allow delete: if isOwner(userId);
          // Only Cloud Functions can create notifications
        }
      }

      // B. PUBLIC DATA
      match /public/data {
        match /region_metadata/{regionId} {
          allow read: if true;
          allow write: if isMod();
        }

        match /threads/{threadId} {
          // Unapproved content is only visible to its author and mods.
          // (Queries must filter status == 'approved' or creatorId == uid;
          //  legacy docs without status are covered by the backfill script.)
          allow read: if resource.data.status == 'approved'
                      || !('status' in resource.data)
                      || (isSignedIn() && request.auth.uid == resource.data.creatorId)
                      || isMod();
          allow create: if isSignedIn() && !isBanned()
                        && isValidTitle(request.resource.data.title)
                        && request.resource.data.regionId is string
                        && request.resource.data.creatorId == request.auth.uid
                        // Threads go through moderation like posts: only trusted+ may self-approve
                        && (request.resource.data.status == 'pending' || (request.resource.data.status == 'approved' && isTrusted()))
                        // Anti-impersonation: displayed author name must match one of
                        // the caller's own characters
                        && (!('createdBy' in request.resource.data)
                            || (request.resource.data.characterId is string
                                && request.resource.data.createdBy == get(/databases/$(database)/documents/artifacts/realm-of-allania-v2/users/$(request.auth.uid)/characters/$(request.resource.data.characterId)).data.name));

          // Reply bump: any signed-in, non-banned user may update thread activity
          // metadata when posting a reply (posts + this update commit as one batch)
          allow update: if isSignedIn() && !isBanned()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt', 'postCount'])
                        && request.resource.data.postCount is int
                        && request.resource.data.postCount == resource.data.get('postCount', 0) + 1;

          allow update: if isSignedIn() && !isBanned()
                        && (request.auth.uid == resource.data.creatorId || isMod())
                        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['title']) || isValidTitle(request.resource.data.title))
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['creatorId', 'createdAt', 'createdBy', 'characterId'])
                        // Moderation status may only be changed by mods (matches posts/codex)
                        && (isMod() || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']))
                        // Sacred Texts: Only mods can toggle isLocked, and locked threads can only be edited by mods
                        && (isMod() || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isLocked']))
                        && (isMod() || resource.data.isLocked != true);
          allow delete: if isMod();
        }

        match /posts/{postId} {
          // Unapproved content is only visible to its author and mods
          allow read: if resource.data.status == 'approved'
                      || !('status' in resource.data)
                      || (isSignedIn() && request.auth.uid == resource.data.userId)
                      || isMod();
          allow create: if isSignedIn() && !isBanned()
                        && isValidPostContent(request.resource.data.content)
                        && request.resource.data.threadId is string
                        && request.resource.data.userId == request.auth.uid
                        && (
                             request.resource.data.status == 'pending' ||
                             (request.resource.data.status == 'approved' && isTrusted())
                           )
                        // Anti-impersonation: displayed character name must match one of
                        // the caller's own characters
                        && (!('characterName' in request.resource.data)
                            || (request.resource.data.characterId is string
                                && request.resource.data.characterName == get(/databases/$(database)/documents/artifacts/realm-of-allania-v2/users/$(request.auth.uid)/characters/$(request.resource.data.characterId)).data.name));
          allow update: if isSignedIn() && !isBanned() && (request.auth.uid == resource.data.userId || isMod())
                        && isValidPostContent(request.resource.data.content)
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['userId', 'createdAt', 'threadId', 'characterName', 'characterId'])
                        // Prevent users from editing status, but allow mods
                        && (isMod() || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']))
                        // Sacred Texts: Only mods can toggle isLocked, and locked posts can only be edited by mods
                        && (isMod() || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isLocked']))
                        && (isMod() || resource.data.isLocked != true);
          allow delete: if isMod();
        }

        match /codex_pages/{pageId} {
          // Unapproved content is only visible to its author and mods
          allow read: if resource.data.status == 'approved'
                      || !('status' in resource.data)
                      || (isSignedIn() && request.auth.uid == resource.data.creatorId)
                      || isMod();
          allow create: if isSignedIn() && !isBanned() 
                        && request.resource.data.creatorId == request.auth.uid 
                        && request.resource.data.lastEditorId == request.auth.uid 
                        && isValidTitle(request.resource.data.title) 
                        && isValidContent(request.resource.data.content) 
                        && isValidGallery(request.resource.data.gallery)
                        && (request.resource.data.status == 'pending' || (request.resource.data.status == 'approved' && isTrusted()));
          allow update: if isSignedIn() && !isBanned() 
                        && (request.resource.data.lastEditorId == request.auth.uid || isMod())
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['creatorId']) 
                        && isValidTitle(request.resource.data.title) 
                        && isValidContent(request.resource.data.content) 
                        && isValidGallery(request.resource.data.gallery)
                        && (isMod() || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']))
                        // Sacred Texts: Only mods can toggle isLocked, and locked pages can only be edited by mods
                        && (isMod() || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isLocked']))
                        && (isMod() || resource.data.isLocked != true);
          allow delete: if isMod();
        }
        
        // Moderation Logs (Admin/Mod read + update, Cloud Functions write)
        match /moderation_logs/{logId} {
          allow read: if isMod();
          // Allow mods to update status (approve/reject) but not create new logs
          allow update: if isMod() 
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'moderatedBy', 'moderatedAt', 'moderationMethod']);
          allow delete: if isMod();
          // Create only allowed from Cloud Functions (not client)
          allow create: if false;
        }
      }

      // C. CHATS
      match /chats/{chatId} {
        allow create: if isSignedIn() && !isBanned()
                      && request.resource.data.participants is list
                      && request.resource.data.participants.size() == 2
                      && request.auth.uid in request.resource.data.participants
                      && request.resource.data.lastMessage is string
                      && request.resource.data.lastMessage.size() <= 2000
                      // participantNames may only carry entries for the two participants
                      && (!('participantNames' in request.resource.data)
                          || (request.resource.data.participantNames is map
                              && request.resource.data.participantNames.keys().hasOnly(request.resource.data.participants)));

        allow read, delete: if isSignedIn() && !isBanned() && request.auth.uid in resource.data.participants;

        // Participants may only bump chat metadata (not rewrite participants/names)
        allow update: if isSignedIn() && !isBanned() && request.auth.uid in resource.data.participants
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'updatedAt'])
                      && request.resource.data.lastMessage is string
                      && request.resource.data.lastMessage.size() <= 2000;
        match /messages/{messageId} {
           // Allow read/delete if participant
           allow read, delete: if isSignedIn() && !isBanned() && request.auth.uid in get(/databases/$(database)/documents/artifacts/realm-of-allania-v2/chats/$(chatId)).data.participants;

           // Strict creation: Must be participant + senderId matches + valid content
           // + flood control: at most one message per second per chat (the chat
           // doc's updatedAt is bumped with each send)
           allow create: if isSignedIn() && !isBanned()
                         && request.auth.uid in get(/databases/$(database)/documents/artifacts/realm-of-allania-v2/chats/$(chatId)).data.participants
                         && request.resource.data.senderId == request.auth.uid
                         && request.resource.data.text is string
                         && request.resource.data.text.size() > 0
                         && request.resource.data.text.size() <= 2000
                         && (!('updatedAt' in get(/databases/$(database)/documents/artifacts/realm-of-allania-v2/chats/$(chatId)).data)
                             || request.time > get(/databases/$(database)/documents/artifacts/realm-of-allania-v2/chats/$(chatId)).data.updatedAt + duration.value(1, 's'));

           // No updates allowed (immutability)
           allow update: if false;
        }
      }
    }
  }
}
