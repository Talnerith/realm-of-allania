rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- 1. CORE FUNCTIONS ---
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }

    function accountPath(userId) {
      return /databases/$(database)/documents/artifacts/realm-of-allania-v2/users/$(userId)/settings/account;
    }

    // Helper to get current character count (default to 0 if missing)
    function getCharCount(userId) {
       return exists(accountPath(userId))
              ? get(accountPath(userId)).data.get('characterCount', 0)
              : 0;
    }

    // SAFE ROLE CHECK:
    function getUserRole() {
      // Check if document exists first to avoid crash
      return exists(accountPath(request.auth.uid))
             ? get(accountPath(request.auth.uid)).data.role
             : 'user';
    }

    function isAdmin() { return isSignedIn() && getUserRole() == 'admin'; }
    function isMod() { return isSignedIn() && (getUserRole() == 'admin' || getUserRole() == 'moderator'); }
    function isBanned() { return isSignedIn() && getUserRole() == 'banned'; }

    // Anyone creating or changing public content: signed in with a verified
    // email (the UI already requires it; this stops scripted throwaway
    // accounts) and not banned.
    function canWrite() {
      return isSignedIn() && request.auth.token.email_verified == true && !isBanned();
    }

    function changedKeys() { return request.resource.data.diff(resource.data).affectedKeys(); }

    // Logic-based text filters for content that isn't AI-moderated (chat,
    // character profiles, display names). Generated from
    // src/lib/moderation/textRules.js; textRules.test.js fails if they drift.
    function hasForbiddenText(text) { return text is string && text.lower().matches('[\\s\\S]*(fake_keyword_for_testing|buy crypto|free money|free robux|cheap rolex|viagra|cialis|porn|(^|[^a-z0-9])(xxx|kys)([^a-z0-9]|$))[\\s\\S]*'); }
    function isReservedName(name) { return name is string && name.lower().matches('[\\s\\S]*(^|[^a-z0-9])(admin|administrator|moderator|mod|mods|staff|official|system|support|gm|gamemaster|game master|owner|developer|dev)([^a-z0-9]|$)[\\s\\S]*'); }
    // A name others will see: no blocked words, and only staff may look like staff
    function isAcceptableName(name) { return !hasForbiddenText(name) && (!isReservedName(name) || isMod()); }
    // Public author name (2-30 characters), set at registration
    function isValidDisplayName(name) { return name is string && name.size() >= 2 && name.size() <= 30 && isAcceptableName(name); }
    // Author names are unique, ignoring case and runs of spaces: each one is
    // claimed by a usernames/{key} doc holding the owner's uid. Same key as
    // nameKey() in src/lib/profiles.js.
    function nameKey(name) { return 'n_' + name.lower().replace('[ \\t]+', ' ').replace('/', '_'); }
    function usernamePath(key) { return /databases/$(database)/documents/artifacts/realm-of-allania-v2/public/data/usernames/$(key); }
    function profilePath(uid) { return /databases/$(database)/documents/artifacts/realm-of-allania-v2/public/data/profiles/$(uid); }
    // A new or changed name: valid, without stray spaces, and claimed by the
    // writer in the same batch
    function isNewDisplayName(name) {
      return isValidDisplayName(name) && name.trim() == name
          && existsAfter(usernamePath(nameKey(name)))
          && getAfter(usernamePath(nameKey(name))).data.uid == request.auth.uid;
    }

    // --- 2. VALIDATION (Anti-Spam & Limits) ---
    function isValidContent(text) { return text is string && text.size() >= 10 && text.size() <= 10000; }
    function isValidPostContent(text) { return text is string && text.size() >= 10 && text.size() <= 5000; }
    function isValidTitle(title) { return title is string && title.size() >= 3 && title.size() <= 140; }
    function isValidGallery(gallery) { return gallery is list && gallery.size() <= 5; }
    function isShortString(value, max) { return value is string && value.size() <= max; }
    // Images the site may show: an object in this project's Storage bucket (its
    // name is one encoded path segment, so "../" can't reach another bucket) or
    // one of the site's own files; '' for none. Matches isHostedImageUrl in
    // src/lib/imageUrls.js.
    function isHostedUrl(url) {
      return url is string && url.size() <= 2048
          && (url == ''
              || url.matches('https://firebasestorage[.]googleapis[.]com/v0/b/realm-of-aethelraed[.]firebasestorage[.]app/o/[^/\\\\?#]+([?#].*)?')
              || url.matches('/[^/\\\\][^\\\\]*'));
    }
    // An optional image field: absent, or hosted
    function hostedField(data, key) { return !(key in data) || isHostedUrl(data[key]); }
    function isValidGalleryImages(gallery) {
      return isValidGallery(gallery)
          && (gallery.size() < 1 || isHostedUrl(gallery[0]))
          && (gallery.size() < 2 || isHostedUrl(gallery[1]))
          && (gallery.size() < 3 || isHostedUrl(gallery[2]))
          && (gallery.size() < 4 || isHostedUrl(gallery[3]))
          && (gallery.size() < 5 || isHostedUrl(gallery[4]));
    }
    // Codex titles may be a single letter (character names can be)
    function isValidCodexTitle(title) { return title is string && title.trim().size() >= 1 && title.size() <= 140; }
    // Codex categories are shown publicly, so keep them short and clean
    function isValidCategory(category) { return isShortString(category, 40) && !hasForbiddenText(category); }
    // What a codex page is about: nothing, a region (numeric id) or one of the
    // writer's own characters, so nobody can attach a page to someone else's character
    function isValidRelatedId(relatedId) {
      return relatedId == ''
          || (relatedId is string && relatedId.matches('[0-9]{1,4}'))
          || (relatedId is string && relatedId.size() <= 128
              && exists(/databases/$(database)/documents/artifacts/realm-of-allania-v2/users/$(request.auth.uid)/characters/$(relatedId)));
    }
    // Thread tags: up to 3 from the fixed list (THREAD_TAGS in src/lib/constants.js)
    function isValidTags(tags) {
      return tags is list && tags.size() <= 3
          && tags.hasOnly(['Roleplay', 'Adventure', 'Lore', 'Investigation', 'Discussion', 'Open', 'Ongoing', 'Politics', 'Trade']);
    }
    // Codex page tags: up to 3 free-text labels chosen by the writer
    function isCodexTag(t) { return t is string && t.size() >= 1 && t.size() <= 24 && !hasForbiddenText(t); }
    function isValidCodexTags(tags) {
      return tags is list && tags.size() <= 3
          && (tags.size() < 1 || isCodexTag(tags[0]))
          && (tags.size() < 2 || isCodexTag(tags[1]))
          && (tags.size() < 3 || isCodexTag(tags[2]));
    }
    // Thread summary fields only Cloud Functions write (from approved posts)
    function threadServerFields() { return ['excerpt', 'openingPostId', 'lastPostBy', 'lastPostCharacterId', 'lastPostUserId', 'lastPostAt', 'views']; }
    function isValidCharacter(data) {
      return isShortString(data.name, 60) && data.name.size() >= 1
          && isShortString(data.get('race', ''), 40)
          && isShortString(data.get('class', ''), 40)
          && isShortString(data.get('description', ''), 5000)
          && isShortString(data.get('imageUrl', ''), 2048)
          && data.keys().size() <= 16
          // Profiles are public and shown on every post, so they get the logic filter
          && isAcceptableName(data.name)
          && !hasForbiddenText(data.get('race', ''))
          && !hasForbiddenText(data.get('class', ''))
          && !hasForbiddenText(data.get('description', ''));
    }

    // Fields only the moderation pipeline (Cloud Functions / moderators) sets
    function touchesModerationFields() {
      return changedKeys().hasAny(['flaggedReason', 'moderationMethod', 'moderatedAt', 'moderatedBy', 'approvedSnapshot', 'imageStatus']);
    }
    function setsModerationFields() {
      return request.resource.data.keys().hasAny(['flaggedReason', 'moderationMethod', 'moderatedAt', 'moderatedBy', 'approvedSnapshot', 'imageStatus']);
    }

    // --- 3. APP RULES ---
    match /artifacts/realm-of-allania-v2 {

      // D. PRESENCE (Active Users)
      match /presence/{userId} {
        allow read: if isSignedIn();
        // Shown in Active Users: the player's own author name (so nobody can
        // appear as someone else), with the server's time (no "online forever")
        allow create, update: if isOwner(userId) && !isBanned()
                              && request.resource.data.keys().hasOnly(['username', 'lastSeen'])
                              && request.resource.data.lastSeen == request.time
                              && request.resource.data.username == get(profilePath(userId)).data.displayName;
        allow delete: if isOwner(userId);
      }

      // A. USER PROFILES
      match /users/{userId} {
        match /settings/account {
          allow read: if isOwner(userId) || isMod();

          // Admin Permissions (Strict Role Enforcement)
          allow create: if isAdmin() && request.resource.data.role in ['user', 'trusted', 'moderator', 'admin', 'banned'];
          allow update: if isAdmin() && (!changedKeys().hasAny(['role']) || request.resource.data.role in ['user', 'trusted', 'moderator', 'admin', 'banned']);
          allow delete: if isAdmin();

          // User Permissions (characterCount may only move by 1 per write, so the
          // 10-character cap can't be reset by writing an arbitrary low value)
          allow create: if isOwner(userId) && request.resource.data.role == 'user';
          allow update: if isOwner(userId)
                        && !changedKeys().hasAny(['role', 'promotedAt', 'promotionReason'])
                        // Player settings: the Landing "Don't show this again" choice and
                        // the character they're playing as
                        && (!changedKeys().hasAny(['hideWelcome']) || request.resource.data.hideWelcome is bool)
                        && (!changedKeys().hasAny(['activeCharId'])
                            || request.resource.data.activeCharId == null
                            || isShortString(request.resource.data.activeCharId, 128))
                        && (!changedKeys().hasAny(['characterCount'])
                            || (request.resource.data.characterCount is int
                                && request.resource.data.characterCount >= 0
                                && request.resource.data.characterCount <= 10
                                && (request.resource.data.characterCount - resource.data.get('characterCount', 0) == 1
                                    // Going down needs a character really deleted in the same batch,
                                    // or the cap could be reset by decrementing alone
                                    || (request.resource.data.characterCount - resource.data.get('characterCount', 0) == -1
                                        && request.resource.data.get('lastDeletedCharId', null) is string
                                        && exists(/databases/$(database)/documents/artifacts/realm-of-allania-v2/users/$(userId)/characters/$(request.resource.data.lastDeletedCharId))
                                        && !existsAfter(/databases/$(database)/documents/artifacts/realm-of-allania-v2/users/$(userId)/characters/$(request.resource.data.lastDeletedCharId))))))
                        && (!changedKeys().hasAny(['lastDeletedCharId']) || changedKeys().hasAny(['characterCount']));
        }

        match /characters/{charId} {
          allow read: if true;
          // The counter must go up in the same batch, so the 10-character cap
          // can't be skipped by creating characters without counting them
          allow create: if isOwner(userId) && canWrite()
                        && getCharCount(userId) < 10
                        && getAfter(accountPath(userId)).data.get('characterCount', 0) == getCharCount(userId) + 1
                        && isValidCharacter(request.resource.data)
                        && hostedField(request.resource.data, 'imageUrl')
                        && !('likesReceived' in request.resource.data);
          // likesReceived (reputation) belongs to the countPostLikes function
          allow update: if (isOwner(userId) && canWrite() && isValidCharacter(request.resource.data)
                            && (!changedKeys().hasAny(['imageUrl']) || isHostedUrl(request.resource.data.imageUrl))
                            && !changedKeys().hasAny(['likesReceived'])) || isAdmin();
          allow delete: if isOwner(userId) || isAdmin();
        }

        match /readReceipts/{threadId} {
          allow read, write: if isOwner(userId);
        }

        match /notifications/{notificationId} {
          allow read: if isOwner(userId);
          allow update: if isOwner(userId) && changedKeys().hasOnly(['read']);
          allow delete: if isOwner(userId);
          // Only Cloud Functions can create notifications
        }
      }

      // B. PUBLIC DATA
      match /public/data {
        match /region_metadata/{regionId} {
          allow read: if true;
          allow write: if isMod();
        }

        match /threads/{threadId} {
          // Unapproved content is only visible to its author and mods.
          // (Queries must filter status == 'approved' or creatorId == uid;
          //  legacy docs without status are covered by the backfill script.)
          allow read: if resource.data.status == 'approved'
                      || !('status' in resource.data)
                      || (isSignedIn() && request.auth.uid == resource.data.creatorId)
                      || isMod();
          allow create: if canWrite()
                        && isValidTitle(request.resource.data.title)
                        && request.resource.data.regionId is string
                        && request.resource.data.creatorId == request.auth.uid
                        // Threads are published by the moderation function together with
                        // their first approved post (which also moderates the title)
                        && (request.resource.data.status == 'pending' || (request.resource.data.status == 'approved' && isMod()))
                        && request.resource.data.updatedAt == request.time
                        && request.resource.data.get('postCount', 1) == 1
                        && (!('isLocked' in request.resource.data) || isMod())
                        && !setsModerationFields()
                        && (!('tags' in request.resource.data) || isValidTags(request.resource.data.tags))
                        && !request.resource.data.keys().hasAny(threadServerFields())
                        && !('lastReplyPostId' in request.resource.data)
                        && hostedField(request.resource.data, 'bannerUrl')
                        && isShortString(request.resource.data.get('bannerPosition', 'center'), 40)
                        // Anti-impersonation: displayed author name must match one of
                        // the caller's own characters
                        && (!('createdBy' in request.resource.data)
                            || (request.resource.data.characterId is string
                                && request.resource.data.createdBy == get(/databases/$(database)/documents/artifacts/realm-of-allania-v2/users/$(request.auth.uid)/characters/$(request.resource.data.characterId)).data.name));

          // Reply bump: posting a reply updates the thread's activity metadata in
          // the same batch. The timestamp must be the server's, so a thread can't
          // be pinned to the top with a future date, and lastReplyPostId must
          // name the writer's new post in this thread, created in the same batch,
          // so a thread can't be bumped without posting.
          allow update: if canWrite()
                        && changedKeys().hasOnly(['updatedAt', 'postCount', 'lastReplyPostId'])
                        && request.resource.data.updatedAt == request.time
                        && request.resource.data.postCount is int
                        && request.resource.data.postCount == resource.data.get('postCount', 0) + 1
                        && request.resource.data.get('lastReplyPostId', null) is string
                        && !exists(/databases/$(database)/documents/artifacts/realm-of-allania-v2/public/data/posts/$(request.resource.data.lastReplyPostId))
                        && getAfter(/databases/$(database)/documents/artifacts/realm-of-allania-v2/public/data/posts/$(request.resource.data.lastReplyPostId)).data.threadId == threadId
                        && getAfter(/databases/$(database)/documents/artifacts/realm-of-allania-v2/public/data/posts/$(request.resource.data.lastReplyPostId)).data.userId == request.auth.uid
                        // Sealed threads take no replies, except from mods
                        && (resource.data.get('isLocked', false) != true || isMod())
                        && (resource.data.get('status', 'approved') == 'approved'
                            || resource.data.creatorId == request.auth.uid
                            || isMod());

          allow update: if canWrite()
                        && (request.auth.uid == resource.data.creatorId || isMod())
                        && (!changedKeys().hasAny(['title']) || isValidTitle(request.resource.data.title))
                        && !changedKeys().hasAny(['creatorId', 'createdAt', 'createdBy', 'characterId'])
                        && !changedKeys().hasAny(threadServerFields())
                        && (!changedKeys().hasAny(['tags']) || isValidTags(request.resource.data.tags))
                        // The title was moderated with the first post and activity metadata
                        // belongs to the reply bump, so owners may change neither
                        && (isMod() || !changedKeys().hasAny(['title', 'postCount', 'updatedAt', 'lastReplyPostId']))
                        && (!changedKeys().hasAny(['bannerUrl']) || isHostedUrl(request.resource.data.bannerUrl))
                        && (!changedKeys().hasAny(['bannerPosition']) || isShortString(request.resource.data.bannerPosition, 40))
                        // Moderation status may only be changed by mods (matches posts/codex)
                        && (isMod() || !changedKeys().hasAny(['status']))
                        && (isMod() || !touchesModerationFields())
                        // Sacred Texts: Only mods can toggle isLocked, and locked threads can only be edited by mods
                        && (isMod() || !changedKeys().hasAny(['isLocked']))
                        && (isMod() || resource.data.get('isLocked', false) != true);

          // View counter: any signed-in player may add exactly one view to a
          // published thread (the client counts once per thread per session)
          allow update: if isSignedIn() && !isBanned()
                        && changedKeys().hasOnly(['views'])
                        && request.resource.data.views == resource.data.get('views', 0) + 1
                        && resource.data.get('status', 'approved') == 'approved';
          allow delete: if isMod();
        }

        match /posts/{postId} {
          function postMatchesCharacter(post, character) {
            return post.characterName == character.name
                && post.get('characterRace', '') == character.get('race', '')
                && post.get('characterClass', '') == character.get('class', '')
                && post.get('characterImageUrl', '') == character.get('imageUrl', '');
          }
          function threadAfter(threadId) {
            return getAfter(/databases/$(database)/documents/artifacts/realm-of-allania-v2/public/data/threads/$(threadId));
          }

          // Unapproved content is only visible to its author and mods
          allow read: if resource.data.status == 'approved'
                      || !('status' in resource.data)
                      || (isSignedIn() && request.auth.uid == resource.data.userId)
                      || isMod();
          allow create: if canWrite()
                        && isValidPostContent(request.resource.data.content)
                        && request.resource.data.threadId is string
                        && request.resource.data.userId == request.auth.uid
                        // The server's time: a future date would keep the writer "last
                        // reply" (and whose turn it is) forever
                        && request.resource.data.createdAt == request.time
                        // Every post is moderated by the Cloud Function (trusted users only
                        // skip the AI step), so only mods may publish directly
                        && (request.resource.data.status == 'pending' || (request.resource.data.status == 'approved' && isMod()))
                        && (!('isLocked' in request.resource.data) || isMod())
                        && !setsModerationFields()
                        // The like counter belongs to the countPostLikes function
                        && !('likeCount' in request.resource.data)
                        // Posts go into a visible thread or the author's own pending one
                        // (created in the same batch), never into a rejected thread
                        && threadAfter(request.resource.data.threadId) != null
                        // Sealed threads (Sacred Texts) take no new posts, except from mods
                        && (threadAfter(request.resource.data.threadId).data.get('isLocked', false) != true || isMod())
                        && (threadAfter(request.resource.data.threadId).data.get('status', 'approved') == 'approved'
                            || (threadAfter(request.resource.data.threadId).data.creatorId == request.auth.uid
                                && threadAfter(request.resource.data.threadId).data.get('status', 'approved') == 'pending')
                            || isMod())
                        // Anti-impersonation: the character shown on the post (name, race,
                        // class, portrait) must be one of the caller's own, as it is now.
                        // Only the post's content is AI-moderated, so nothing else is free text.
                        && isShortString(request.resource.data.get('characterImagePosition', 'center'), 40)
                        && (('characterName' in request.resource.data)
                            ? (request.resource.data.characterId is string
                               && postMatchesCharacter(request.resource.data,
                                    get(/databases/$(database)/documents/artifacts/realm-of-allania-v2/users/$(request.auth.uid)/characters/$(request.resource.data.characterId)).data))
                            : !request.resource.data.keys().hasAny(['characterRace', 'characterClass', 'characterImageUrl']));
          allow update: if canWrite() && (request.auth.uid == resource.data.userId || isMod())
                        && isValidPostContent(request.resource.data.content)
                        && !changedKeys().hasAny(['userId', 'createdAt', 'threadId', 'characterName', 'characterId', 'likeCount'])
                        && (isMod() || !changedKeys().hasAny(['characterImageUrl', 'characterRace', 'characterClass']))
                        && (isMod() || !touchesModerationFields())
                        // Non-mods may only move a post back to 'pending', and every
                        // content edit must do so, so the edit is re-moderated before
                        // anyone else sees it
                        && (isMod() || !changedKeys().hasAny(['status']) || request.resource.data.status == 'pending')
                        && (isMod() || !changedKeys().hasAny(['content']) || request.resource.data.status == 'pending')
                        // A rejected post goes back to moderation only with new content
                        // (resubmitting the same text would re-roll the AI check)
                        && (isMod() || !(resource.data.get('status', '') in ['rejected', 'needs_review'])
                            || !changedKeys().hasAny(['status']) || changedKeys().hasAny(['content']))
                        // Sacred Texts: Only mods can toggle isLocked, and locked posts can only be edited by mods
                        && (isMod() || !changedKeys().hasAny(['isLocked']))
                        && (isMod() || resource.data.get('isLocked', false) != true);
          allow delete: if isMod();

          // Likes: one per player per post (the doc id is their uid), only on
          // approved posts and never on their own. countPostLikes keeps the
          // post's likeCount and the author's likesReceived in step.
          match /likes/{likerId} {
            function likedPost() {
              return get(/databases/$(database)/documents/artifacts/realm-of-allania-v2/public/data/posts/$(postId));
            }
            allow read: if true;
            allow create: if canWrite() && request.auth.uid == likerId
                          && request.resource.data.keys().hasOnly(['createdAt'])
                          && request.resource.data.createdAt == request.time
                          && exists(/databases/$(database)/documents/artifacts/realm-of-allania-v2/public/data/posts/$(postId))
                          && likedPost().data.get('status', 'approved') == 'approved'
                          && likedPost().data.userId != request.auth.uid;
            allow delete: if isOwner(likerId);
          }
        }

        // Public player profiles: the author name shown on codex entries and
        // posts. Written by the player at registration; likesReceived is the
        // countPostLikes function's.
        match /profiles/{userId} {
          allow read: if true;
          allow create: if isOwner(userId) && !isBanned()
                        && request.resource.data.keys().hasOnly(['displayName', 'createdAt'])
                        && isNewDisplayName(request.resource.data.displayName)
                        && request.resource.data.createdAt == request.time;
          // The author picture is an upload in the player's own Storage folder
          // (checked by moderateImage); the site only renders hosted images.
          // The name is only checked when it changes, so an older name that a
          // newer word list would refuse doesn't block changing the picture.
          allow update: if isOwner(userId) && !isBanned()
                        && changedKeys().hasOnly(['displayName', 'avatarUrl', 'avatarPosition'])
                        && (!changedKeys().hasAny(['displayName']) || isNewDisplayName(request.resource.data.displayName))
                        && (!changedKeys().hasAny(['avatarUrl']) || isHostedUrl(request.resource.data.avatarUrl))
                        && isShortString(request.resource.data.get('avatarPosition', 'center'), 40);
          allow delete: if isAdmin();
        }

        // Author name claims (see nameKey): created with the profile or a
        // rename in one batch, for the name the profile has afterwards, and
        // released only once the owner's profile no longer uses it.
        match /usernames/{key} {
          allow read: if true;
          allow create: if isSignedIn() && !isBanned()
                        && request.resource.data.keys().hasOnly(['uid'])
                        && request.resource.data.uid == request.auth.uid
                        && existsAfter(profilePath(request.auth.uid))
                        && nameKey(getAfter(profilePath(request.auth.uid)).data.displayName) == key;
          allow delete: if (isSignedIn() && resource.data.uid == request.auth.uid
                            && (!existsAfter(profilePath(request.auth.uid))
                                || nameKey(getAfter(profilePath(request.auth.uid)).data.displayName) != key))
                        || isAdmin();
          allow update: if false;
        }

        // Site-wide counts for the Landing page, written by updateSiteStats
        match /stats/{statId} {
          allow read: if true;
          allow write: if false;
        }

        match /codex_pages/{pageId} {
          // Unapproved content is only visible to its author and mods
          allow read: if resource.data.status == 'approved'
                      || !('status' in resource.data)
                      || (isSignedIn() && request.auth.uid == resource.data.creatorId)
                      || isMod();
          allow create: if canWrite()
                        && request.resource.data.creatorId == request.auth.uid
                        && request.resource.data.lastEditorId == request.auth.uid
                        && isValidCodexTitle(request.resource.data.title)
                        && isValidContent(request.resource.data.content)
                        && isValidGalleryImages(request.resource.data.gallery)
                        && hostedField(request.resource.data, 'imageUrl')
                        && isValidCategory(request.resource.data.get('category', ''))
                        && isValidRelatedId(request.resource.data.get('relatedId', ''))
                        && isShortString(request.resource.data.get('updatedBy', ''), 60)
                        && isShortString(request.resource.data.get('imagePosition', 'center'), 40)
                        && (!('tags' in request.resource.data) || isValidCodexTags(request.resource.data.tags))
                        && (request.resource.data.status == 'pending' || (request.resource.data.status == 'approved' && isMod()))
                        // Locking a page would let its creator squat the title
                        && (!('isLocked' in request.resource.data) || isMod())
                        && !setsModerationFields();
          allow update: if canWrite()
                        && (request.resource.data.lastEditorId == request.auth.uid || isMod())
                        && !changedKeys().hasAny(['creatorId'])
                        && isValidCodexTitle(request.resource.data.title)
                        && isValidContent(request.resource.data.content)
                        && isValidGallery(request.resource.data.gallery)
                        && (!changedKeys().hasAny(['gallery']) || isValidGalleryImages(request.resource.data.gallery))
                        && (!changedKeys().hasAny(['imageUrl']) || isHostedUrl(request.resource.data.imageUrl))
                        && (!changedKeys().hasAny(['category']) || isValidCategory(request.resource.data.category))
                        && (!changedKeys().hasAny(['updatedBy']) || isShortString(request.resource.data.updatedBy, 60))
                        && (!changedKeys().hasAny(['imagePosition']) || isShortString(request.resource.data.imagePosition, 40))
                        // Which character or region a page belongs to: only its creator (for
                        // one of their own characters) or a mod may change it
                        && (!changedKeys().hasAny(['relatedId']) || isMod()
                            || (resource.data.creatorId == request.auth.uid && isValidRelatedId(request.resource.data.relatedId)))
                        && (!('tags' in request.resource.data) || isValidCodexTags(request.resource.data.tags))
                        && (isMod() || !touchesModerationFields())
                        // Same as posts: non-mods may only set 'pending', and must when
                        // they change what readers see
                        && (isMod() || !changedKeys().hasAny(['status']) || request.resource.data.status == 'pending')
                        && (isMod() || !changedKeys().hasAny(['title', 'content', 'category', 'tags', 'gallery', 'imageUrl']) || request.resource.data.status == 'pending')
                        // A rejected page goes back to moderation only with changes
                        && (isMod() || !(resource.data.get('status', '') in ['rejected', 'needs_review'])
                            || !changedKeys().hasAny(['status'])
                            || changedKeys().hasAny(['title', 'content', 'category', 'tags', 'gallery', 'imageUrl']))
                        // Sacred Texts: Only mods can toggle isLocked, and locked pages can only be edited by mods
                        && (isMod() || !changedKeys().hasAny(['isLocked']))
                        && (isMod() || resource.data.get('isLocked', false) != true);
          allow delete: if isMod();
        }

        // Moderation Logs (Admin/Mod read + update, Cloud Functions write)
        match /moderation_logs/{logId} {
          allow read: if isMod();
          // Allow mods to update status (approve/reject) but not create new logs
          allow update: if isMod()
                        && changedKeys().hasOnly(['status', 'moderatedBy', 'moderatedAt', 'moderationMethod']);
          allow delete: if isMod();
          // Create only allowed from Cloud Functions (not client)
          allow create: if false;
        }
      }

      // C. CHATS
      match /chats/{chatId} {
        function chatPath() {
          return /databases/$(database)/documents/artifacts/realm-of-allania-v2/chats/$(chatId);
        }

        function characterPath(uid, charId) {
          return /databases/$(database)/documents/artifacts/realm-of-allania-v2/users/$(uid)/characters/$(charId);
        }

        // Chats record which character each person is speaking as; the site
        // shows those characters' real names. Free-text names (the old
        // participantNames) aren't accepted, so nobody can label themselves or
        // the other person as anything else.
        allow create: if canWrite()
                      && request.resource.data.participants is list
                      && request.resource.data.participants.size() == 2
                      && request.resource.data.participants[0] != request.resource.data.participants[1]
                      && request.auth.uid in request.resource.data.participants
                      && request.resource.data.lastMessage is string
                      && request.resource.data.lastMessage.size() <= 2000
                      && !hasForbiddenText(request.resource.data.lastMessage)
                      && request.resource.data.updatedAt == request.time
                      && !('participantNames' in request.resource.data)
                      && request.resource.data.participantCharacters is map
                      && request.resource.data.participantCharacters.keys().hasOnly(request.resource.data.participants)
                      && request.resource.data.participantCharacters.keys().hasAll(request.resource.data.participants)
                      && exists(characterPath(request.resource.data.participants[0],
                                              request.resource.data.participantCharacters[request.resource.data.participants[0]]))
                      && exists(characterPath(request.resource.data.participants[1],
                                              request.resource.data.participantCharacters[request.resource.data.participants[1]]));

        allow read, delete: if isSignedIn() && !isBanned() && request.auth.uid in resource.data.participants;

        // Participants may only bump chat metadata (not rewrite participants/names),
        // with the server's timestamp (a future date would block the other person)
        allow update: if canWrite() && request.auth.uid in resource.data.participants
                      && changedKeys().hasOnly(['lastMessage', 'updatedAt', 'lastMessageId'])
                      && request.resource.data.updatedAt == request.time
                      && request.resource.data.lastMessage is string
                      && request.resource.data.lastMessage.size() <= 2000
                      && !hasForbiddenText(request.resource.data.lastMessage);
        match /messages/{messageId} {
           // Allow read/delete if participant
           allow read, delete: if isSignedIn() && !isBanned() && request.auth.uid in get(chatPath()).data.participants;

           // Strict creation: Must be participant + senderId matches + valid content
           // + flood control: at most one message per second per chat. The chat
           // doc's updatedAt must be bumped in the same batch (getAfter), so the
           // limit can't be skipped by writing messages alone.
           allow create: if canWrite()
                         && request.auth.uid in get(chatPath()).data.participants
                         && request.resource.data.senderId == request.auth.uid
                         && request.resource.data.text is string
                         && request.resource.data.text.size() > 0
                         && request.resource.data.text.size() <= 2000
                         // Chat moderation is logic-based: blocked words never get stored
                         && !hasForbiddenText(request.resource.data.text)
                         && request.resource.data.keys().hasOnly(['text', 'senderId', 'createdAt'])
                         // The server's time: a future date would push newer messages out of view
                         && request.resource.data.createdAt == request.time
                         // One message per write: the chat names this message as its last
                         // (so a batch of many can't all pass the one-per-second check)
                         && getAfter(chatPath()).data.get('lastMessageId', '') == messageId
                         && getAfter(chatPath()).data.updatedAt == request.time
                         && (!('updatedAt' in get(chatPath()).data)
                             || request.time > get(chatPath()).data.updatedAt + duration.value(1, 's'));

           // No updates allowed (immutability)
           allow update: if false;
        }
      }
    }
  }
}
