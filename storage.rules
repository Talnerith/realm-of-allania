rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Match the App ID path
    match /artifacts/realm-of-allania-v2 {
      
      // PUBLIC DATA (Banners, Portraits, Maps)
      
      // 1. LEGACY/ROOT FILES (Read Only to prevent malicious wiping)
      // Matches files directly inside a category folder (e.g. public/character_portraits/image.jpg)
      match /public/{folder}/{filename} {
          allow read: if true;
          // No write allowed here anymore. All new uploads go to userId subfolders.
      }

      // 2. USER-OWNED FILES (The new secure standard)
      // Matches files inside a user-specific subfolder (e.g. public/character_portraits/USER_ID/image.jpg)
      match /public/{folder}/{userId}/{filename} {
        
        // Everyone can view
        allow read: if true;

        // Only the owner of the folder can upload, update, or delete.
        // Uploads need a verified email (like all public content) and must be
        // raster images by both content type and file name: SVG (image/svg+xml)
        // can carry scripts, and the extension check keeps file names honest.
        // Every upload is checked by the moderateImage Cloud Function.
        allow delete: if request.auth != null && request.auth.uid == userId;
        // Banned players can't upload (same as importImageFromUrl). Reads the
        // role from Firestore; a missing account doc counts as a player.
        allow create, update: if request.auth != null
                      && request.auth.uid == userId
                      && request.auth.token.email_verified == true
                      && !(firestore.exists(/databases/(default)/documents/artifacts/realm-of-allania-v2/users/$(userId)/settings/account)
                           && firestore.get(/databases/(default)/documents/artifacts/realm-of-allania-v2/users/$(userId)/settings/account).data.get('role', 'user') == 'banned')
                      && filename.matches('.*[.](jpg|jpeg|png|gif|webp)')
                      && request.resource.contentType.matches('image/(jpeg|png|gif|webp)')
                      && request.resource.size < 5 * 1024 * 1024;
      }
    }
  }
}
